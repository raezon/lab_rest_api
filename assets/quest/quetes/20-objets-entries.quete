=== solution
// Quête 20 — Le grand livre des prix

const appliquerHausse = (carte, euros) =>
  Object.fromEntries(Object.entries(carte).map(([nom, prix]) => [nom, prix + euros]));

const platsChers = (carte, seuil) => Object.fromEntries(Object.entries(carte).filter(([, prix]) => prix >= seuil));

const classement = (chiffres) =>
  Object.entries(chiffres)
    .sort(([, a], [, b]) => b - a)
    .map(([nom]) => nom);

module.exports = { appliquerHausse, platsChers, classement };

=== indices
`Object.entries(carte)` donne un tableau de paires. Chaque étape reçoit une paire, qu'on déstructure : `([nom, prix]) => ...`.
---
Dans le `map`, renvoie une **paire** : `[nom, prix + euros]`. Puis referme avec `Object.fromEntries(...)`.
---
`classement` : `Object.entries(chiffres).sort(([, a], [, b]) => b - a).map(([nom]) => nom)`. `Object.entries` crée un tableau neuf : le trier ne modifie pas l'objet reçu.

=== tests
interdit(/\b(for|while)\b|\.forEach\(/, 'pas de boucle for, while ni forEach');
const CARTE = () => ({ Burger: 14, Soupe: 7, Risotto: 13, Tiramisu: 6 });
test('appliquerHausse augmente chaque prix', (m, t) =>
  t.egal(t.sansMutation(CARTE(), (c) => m.appliquerHausse(c, 1)), { Burger: 15, Soupe: 8, Risotto: 14, Tiramisu: 7 }));
test('appliquerHausse renvoie un nouvel objet', (m, t) => {
  const carte = CARTE();
  t.vrai(m.appliquerHausse(carte, 0) !== carte, 'L\'objet renvoyé est le même que celui reçu.');
});
test('platsChers garde les plats au prix supérieur ou égal au seuil', (m, t) =>
  t.egal(t.sansMutation(CARTE(), (c) => m.platsChers(c, 13)), { Burger: 14, Risotto: 13 }));
test('platsChers renvoie {} si aucun plat n\'atteint le seuil', (m, t) => t.egal(m.platsChers(CARTE(), 100), {}));
test('classement trie les noms du plus gros montant au plus petit', (m, t) =>
  t.egal(t.sansMutation({ entrée: 120, plat: 540, dessert: 210 }, (c) => m.classement(c)), ['plat', 'dessert', 'entrée']));
test('classement d\'un objet vide renvoie []', (m, t) => t.egal(m.classement({}), []));
