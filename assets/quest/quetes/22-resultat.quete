=== solution
// Quête 22 — Retour en cuisine

const ok = (valeur) => ({ ok: true, valeur });

const erreur = (message) => ({ ok: false, erreur: message });

const enchainer = (resultat, fn) => (resultat.ok ? fn(resultat.valeur) : resultat);

const validerCommande = (commande) =>
  typeof commande.table !== 'number' ? erreur('Table manquante')
  : commande.plats.length === 0 ? erreur('Commande vide')
  : ok(commande);

const totalCommande = (commande) =>
  enchainer(validerCommande(commande), (valide) => ok(valide.plats.reduce((somme, plat) => somme + plat.prix, 0)));

module.exports = { ok, erreur, enchainer, validerCommande, totalCommande };

=== indices
`ok` et `erreur` renvoient chacune un objet : pense aux parenthèses autour des accolades, `(valeur) => ({ ok: true, valeur })`.
---
`enchainer` : `resultat.ok ? fn(resultat.valeur) : resultat`. Pour la validation, teste `typeof commande.table !== 'number'` en premier, puis `commande.plats.length === 0`.
---
`totalCommande` : `enchainer(validerCommande(commande), (valide) => ok(...))`. La fonction passée à `enchainer` doit elle-même renvoyer un `ok(...)` contenant la somme des prix.

=== tests
interdit(/\b(throw|try)\b/, 'ni throw, ni try');
const VALIDE = () => ({ table: 4, plats: [{ nom: 'Burger', prix: 14 }, { nom: 'Tiramisu', prix: 6 }] });
test('ok et erreur construisent les deux formes de résultat', (m, t) => {
  t.egal(m.ok(5), { ok: true, valeur: 5 });
  t.egal(m.erreur('Oups'), { ok: false, erreur: 'Oups' });
});
test('enchainer applique la fonction à un résultat ok', (m, t) =>
  t.egal(m.enchainer({ ok: true, valeur: 5 }, (x) => ({ ok: true, valeur: x * 2 })), { ok: true, valeur: 10 }));
test('enchainer laisse passer une erreur sans appeler la fonction', (m, t) => {
  const e = { ok: false, erreur: 'Oups' };
  let appelee = false;
  const r = m.enchainer(e, (x) => {
    appelee = true;
    return { ok: true, valeur: x };
  });
  t.vrai(!appelee, 'La fonction a été appelée alors que le résultat était une erreur.');
  t.egal(r, { ok: false, erreur: 'Oups' });
});
test('validerCommande accepte une commande complète', (m, t) => t.egal(m.validerCommande(VALIDE()), { ok: true, valeur: VALIDE() }));
test('validerCommande refuse une commande sans table', (m, t) =>
  t.egal(m.validerCommande({ plats: [{ nom: 'Burger', prix: 14 }] }), { ok: false, erreur: 'Table manquante' }));
test('validerCommande refuse une commande vide', (m, t) =>
  t.egal(m.validerCommande({ table: 2, plats: [] }), { ok: false, erreur: 'Commande vide' }));
test('la table est vérifiée avant les plats', (m, t) =>
  t.egal(m.validerCommande({ plats: [] }), { ok: false, erreur: 'Table manquante' }));
test('totalCommande renvoie ok(total) pour une commande valide', (m, t) =>
  t.egal(t.sansMutation(VALIDE(), (c) => m.totalCommande(c)), { ok: true, valeur: 20 }));
test('totalCommande transmet l\'erreur de validation', (m, t) =>
  t.egal(m.totalCommande({ table: 2, plats: [] }), { ok: false, erreur: 'Commande vide' }));
