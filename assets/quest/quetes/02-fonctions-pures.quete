=== solution
// Quête 2 — La recette qui ne rate jamais

const additionner = (total, prix) => total + prix;

const prixTTC = (prix, taux) => prix * (1 + taux);

const ticket = (nom, prix) => `${nom} : ${prix} €`;

module.exports = { additionner, prixTTC, ticket };

=== indices
Chaque fonction tient en une ligne : elle calcule à partir de ses paramètres et renvoie le résultat.
---
`prixTTC` : le prix multiplié par `(1 + taux)`. `ticket` : un gabarit `${nom} : ${prix} €`.
---
`const additionner = (total, prix) => total + prix;` et les deux autres sur le même modèle, sans accolades.

=== tests
interdit(/\b(let|var)\b/, 'uniquement const (ni let, ni var)');
test('additionner(10, 5) renvoie 15', (m, t) => t.egal(m.additionner(10, 5), 15));
test('additionner est pure : deux appels identiques, deux résultats identiques', (m, t) => {
  t.egal(m.additionner(0, 10), 10);
  t.egal(m.additionner(0, 10), 10, 'Le deuxième appel donne un autre résultat : ta fonction garde un état.');
});
test('prixTTC(100, 0.2) renvoie 120', (m, t) => t.proche(m.prixTTC(100, 0.2), 120));
test('prixTTC(100, 0.1) renvoie 110 (le taux vient du paramètre)', (m, t) => t.proche(m.prixTTC(100, 0.1), 110));
test("ticket('Burger', 12) renvoie « Burger : 12 € »", (m, t) => t.egal(m.ticket('Burger', 12), 'Burger : 12 €'));
