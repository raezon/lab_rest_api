=== solution
// Quête 9 — Le travail à la chaîne

const nomsVegetariens = (menu) => menu.filter((plat) => plat.vegetarien).map((plat) => plat.nom);

const totalParCategorie = (menu, categorie) =>
  menu.filter((plat) => plat.categorie === categorie).reduce((somme, plat) => somme + plat.prix, 0);

const totalCommande = (commande) => commande.plats.reduce((somme, plat) => somme + plat.prix, 0);

const ticketMoyen = (commandes) =>
  commandes.length === 0 ? 0 : commandes.map(totalCommande).reduce((a, b) => a + b, 0) / commandes.length;

module.exports = { nomsVegetariens, totalParCategorie, ticketMoyen };

=== indices
Enchaîne les méthodes avec un point : `menu.filter(...).map(...)`.
---
Pour `ticketMoyen`, écris d'abord une petite fonction `totalCommande(commande)` qui additionne les prix de `commande.plats`, puis utilise `commandes.map(totalCommande)`.
---
Moyenne : `commandes.length === 0 ? 0 : somme des totaux / commandes.length`. La somme des totaux s'obtient avec `.reduce((a, b) => a + b, 0)`.

=== tests
const MENU = () => [
  { nom: 'Salade César', prix: 9, categorie: 'entrée', vegetarien: false },
  { nom: 'Soupe', prix: 7, categorie: 'entrée', vegetarien: true },
  { nom: 'Burger', prix: 14, categorie: 'plat', vegetarien: false },
  { nom: 'Risotto', prix: 13, categorie: 'plat', vegetarien: true },
  { nom: 'Tiramisu', prix: 6, categorie: 'dessert', vegetarien: true },
];
const COMMANDES = () => [
  { client: 'Alice', plats: [{ nom: 'Salade César', prix: 9 }, { nom: 'Burger', prix: 14 }] },
  { client: 'Karim', plats: [{ nom: 'Risotto', prix: 13 }] },
  { client: 'Lina', plats: [{ nom: 'Tiramisu', prix: 6 }, { nom: 'Tiramisu', prix: 6 }] },
];
interdit(/\b(for|while)\b|\.forEach\(/, 'pas de boucle for, while ni forEach');
test('nomsVegetariens renvoie les noms des plats végétariens', (m, t) =>
  t.egal(t.sansMutation(MENU(), (menu) => m.nomsVegetariens(menu)), ['Soupe', 'Risotto', 'Tiramisu']));
test("totalParCategorie(menu, 'plat') renvoie 27", (m, t) => t.egal(m.totalParCategorie(MENU(), 'plat'), 27));
test("totalParCategorie(menu, 'entrée') renvoie 16", (m, t) => t.egal(m.totalParCategorie(MENU(), 'entrée'), 16));
test('totalParCategorie vaut 0 pour une catégorie absente', (m, t) => t.egal(m.totalParCategorie(MENU(), 'boisson'), 0));
test('ticketMoyen renvoie la moyenne des totaux (23, 13 et 12 donnent 16)', (m, t) =>
  t.proche(t.sansMutation(COMMANDES(), (c) => m.ticketMoyen(c)), 16));
test('ticketMoyen sans commande vaut 0', (m, t) => t.egal(m.ticketMoyen([]), 0, 'Attention à la division par zéro.'));
