=== solution
// Quête 24 — La brigade au complet

const pipe = (...fonctions) => (valeur) => fonctions.reduce((acc, fn) => fn(acc), valeur);

const map = (fn) => (tableau) => tableau.map(fn);

const filter = (predicat) => (tableau) => tableau.filter(predicat);

const reduce = (fn, initial) => (tableau) => tableau.reduce(fn, initial);

const prop = (cle) => (objet) => objet[cle];

const totalVegetarien = pipe(
  filter(prop('vegetarien')),
  map(prop('prix')),
  reduce((a, b) => a + b, 0)
);

module.exports = { map, filter, reduce, prop, totalVegetarien };

=== indices
Chaque outil a deux flèches : la configuration, puis la donnée. Par exemple `const map = (fn) => (tableau) => tableau.map(fn);`
---
`prop('prix')` doit renvoyer une fonction `(objet) => objet[cle]`. Utilise les crochets : la clé est dans une variable.
---
`const totalVegetarien = pipe(filter(prop('vegetarien')), map(prop('prix')), reduce((a, b) => a + b, 0));`

=== tests
requis(/totalVegetarien\s*=\s*pipe\(/, 'totalVegetarien est construit directement avec pipe(…), en style point-free');
const MENU = () => [
  { nom: 'Salade César', prix: 9, vegetarien: false },
  { nom: 'Soupe', prix: 7, vegetarien: true },
  { nom: 'Risotto', prix: 13, vegetarien: true },
  { nom: 'Tiramisu', prix: 6, vegetarien: true },
];
test('map(fn) renvoie une fonction qui attend le tableau', (m, t) => {
  t.vrai(typeof m.map((x) => x) === 'function', 'map(fn) doit renvoyer une fonction.');
  t.egal(m.map((n) => n * 2)([1, 2, 3]), [2, 4, 6]);
});
test('filter(predicat)(tableau) filtre', (m, t) => t.egal(m.filter((n) => n > 1)([1, 2, 3]), [2, 3]));
test('reduce(fn, initial)(tableau) réduit', (m, t) => {
  t.egal(m.reduce((a, b) => a + b, 0)([1, 2, 3]), 6);
  t.egal(m.reduce((a, b) => a + b, 0)([]), 0);
});
test("prop('prix') lit la propriété d'un objet", (m, t) => {
  t.egal(m.prop('prix')({ nom: 'Burger', prix: 14 }), 14);
  t.egal(m.prop('nom')({ nom: 'Burger', prix: 14 }), 'Burger');
});
test('les outils se combinent : map(prop(\'nom\'))', (m, t) =>
  t.egal(m.map(m.prop('nom'))(MENU()), ['Salade César', 'Soupe', 'Risotto', 'Tiramisu']));
test('totalVegetarien(menu) renvoie 26', (m, t) => {
  t.vrai(typeof m.totalVegetarien === 'function', 'totalVegetarien doit être une fonction : remplace undefined par un pipe.');
  t.egal(t.sansMutation(MENU(), (menu) => m.totalVegetarien(menu)), 26);
});
test('totalVegetarien d\'un menu vide vaut 0', (m, t) => t.egal(m.totalVegetarien([]), 0));
