=== solution
// Quête 17 — La liste de courses

const dedoublonner = (tableau) => [...new Set(tableau)];

const tousLesPlats = (commandes) => commandes.flatMap((commande) => commande.plats).map((plat) => plat.nom);

const listeDeCourses = (commandes) =>
  dedoublonner(commandes.flatMap((commande) => commande.plats).flatMap((plat) => plat.ingredients)).sort();

module.exports = { dedoublonner, tousLesPlats, listeDeCourses };

=== indices
`[...new Set(tableau)]` retire les doublons. `commandes.flatMap((c) => c.plats)` donne tous les plats à plat.
---
Pour les ingrédients, enchaîne un second `flatMap` : `.flatMap((plat) => plat.ingredients)`.
---
`listeDeCourses` : aplatis jusqu'aux ingrédients, passe le résultat à `dedoublonner`, puis termine par `.sort()`. Le tableau renvoyé par `dedoublonner` est neuf : le trier ne modifie rien d'autre.

=== tests
interdit(/\b(for|while)\b|\.forEach\(|\.push\(/, 'pas de boucle ni de push');
const COMMANDES = () => [
  { table: 1, plats: [
    { nom: 'Burger', ingredients: ['pain', 'boeuf', 'salade'] },
    { nom: 'Soupe', ingredients: ['carotte', 'oignon'] },
  ] },
  { table: 2, plats: [{ nom: 'Burger', ingredients: ['pain', 'boeuf', 'salade'] }] },
  { table: 3, plats: [] },
  { table: 4, plats: [{ nom: 'Salade', ingredients: ['salade', 'tomate', 'oignon'] }] },
];
test('dedoublonner retire les doublons en gardant l\'ordre', (m, t) =>
  t.egal(t.sansMutation(['b', 'a', 'b', 'c', 'a'], (x) => m.dedoublonner(x)), ['b', 'a', 'c']));
test('dedoublonner renvoie un nouveau tableau', (m, t) => {
  const original = ['a', 'b'];
  t.vrai(m.dedoublonner(original) !== original, 'Le tableau renvoyé est le même objet que celui reçu.');
});
test('tousLesPlats renvoie les noms à plat, doublons compris', (m, t) =>
  t.egal(m.tousLesPlats(COMMANDES()), ['Burger', 'Soupe', 'Burger', 'Salade']));
test('listeDeCourses renvoie les ingrédients uniques, triés', (m, t) =>
  t.egal(t.sansMutation(COMMANDES(), (c) => m.listeDeCourses(c)), ['boeuf', 'carotte', 'oignon', 'pain', 'salade', 'tomate']));
test('listeDeCourses sans commande renvoie []', (m, t) => t.egal(m.listeDeCourses([]), []));
