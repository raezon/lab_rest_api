=== solution
// Quête 16 — Ranger le garde-manger

const compterParCategorie = (menu) =>
  menu.reduce((acc, plat) => ({ ...acc, [plat.categorie]: (acc[plat.categorie] || 0) + 1 }), {});

const grouperPar = (tableau, fnCle) =>
  tableau.reduce((acc, element) => {
    const cle = fnCle(element);
    return { ...acc, [cle]: [...(acc[cle] || []), element] };
  }, {});

const grouperParCategorie = (menu) => grouperPar(menu, (plat) => plat.categorie);

module.exports = { compterParCategorie, grouperPar, grouperParCategorie };

=== indices
Pars de `{}` et renvoie à chaque tour `{ ...acc, [cle]: nouvelleValeur }`.
---
Pour compter : `(acc[cle] || 0) + 1`. Pour regrouper : `[...(acc[cle] || []), element]`.
---
Dans `grouperPar`, calcule d'abord `const cle = fnCle(element);`. Ensuite `grouperParCategorie` tient en une ligne : `grouperPar(menu, (plat) => plat.categorie)`.

=== tests
interdit(/\b(for|while)\b|\.forEach\(|\.push\(/, 'pas de boucle ni de push');
const MENU = () => [
  { nom: 'Salade', categorie: 'entrée' },
  { nom: 'Burger', categorie: 'plat' },
  { nom: 'Soupe', categorie: 'entrée' },
  { nom: 'Tiramisu', categorie: 'dessert' },
  { nom: 'Risotto', categorie: 'plat' },
];
test('compterParCategorie compte les plats de chaque catégorie', (m, t) =>
  t.egal(t.sansMutation(MENU(), (menu) => m.compterParCategorie(menu)), { entrée: 2, plat: 2, dessert: 1 }));
test('compterParCategorie d\'un menu vide renvoie {}', (m, t) => t.egal(m.compterParCategorie([]), {}));
test('grouperPar regroupe selon la fonction de clé', (m, t) =>
  t.egal(m.grouperPar([1, 2, 3, 4, 5], (n) => (n % 2 === 0 ? 'pair' : 'impair')), { impair: [1, 3, 5], pair: [2, 4] }));
test('grouperPar accepte n\'importe quelle clé', (m, t) =>
  t.egal(m.grouperPar(['Soupe', 'Salade', 'Burger'], (nom) => nom[0]), { S: ['Soupe', 'Salade'], B: ['Burger'] }));
test('grouperParCategorie renvoie les plats par catégorie, dans l\'ordre', (m, t) => {
  const menu = MENU();
  const r = t.sansMutation(menu, (x) => m.grouperParCategorie(x));
  t.egal(r, { entrée: [menu[0], menu[2]], plat: [menu[1], menu[4]], dessert: [menu[3]] });
});
