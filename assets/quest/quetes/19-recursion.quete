=== solution
// Quête 19 — La carte gigogne

const estPlat = (noeud) => !noeud.enfants;

const compterPlats = (noeud) =>
  estPlat(noeud) ? 1 : noeud.enfants.reduce((total, enfant) => total + compterPlats(enfant), 0);

const totalCarte = (noeud) =>
  estPlat(noeud) ? noeud.prix : noeud.enfants.reduce((total, enfant) => total + totalCarte(enfant), 0);

const nomsDesPlats = (noeud) => (estPlat(noeud) ? [noeud.nom] : noeud.enfants.flatMap(nomsDesPlats));

module.exports = { compterPlats, totalCarte, nomsDesPlats };

=== indices
Chaque fonction commence par `estPlat(noeud) ? casDeBase : casRecursif`. Pour `compterPlats`, le cas de base vaut `1`.
---
Cas récursif : `noeud.enfants.reduce((total, enfant) => total + compterPlats(enfant), 0)`. La fonction s'appelle elle-même sur chaque enfant.
---
`nomsDesPlats` : le cas de base renvoie `[noeud.nom]`, le cas récursif `noeud.enfants.flatMap(nomsDesPlats)`.

=== tests
interdit(/\b(for|while)\b/, 'pas de boucle for ni while');
const CARTE = () => ({
  nom: 'Carte',
  enfants: [
    { nom: 'Entrées', enfants: [{ nom: 'Soupe', prix: 7 }, { nom: 'Salade', prix: 9 }] },
    { nom: 'Plats', enfants: [
      { nom: 'Burger', prix: 14 },
      { nom: 'Végétariens', enfants: [{ nom: 'Risotto', prix: 13 }] },
    ] },
    { nom: 'Tiramisu', prix: 6 },
  ],
});
test('compterPlats compte un plat seul', (m, t) => t.egal(m.compterPlats({ nom: 'Soupe', prix: 7 }), 1));
test('compterPlats parcourt toute la profondeur', (m, t) => t.egal(t.sansMutation(CARTE(), (c) => m.compterPlats(c)), 5));
test('totalCarte additionne tous les prix', (m, t) => t.egal(m.totalCarte(CARTE()), 49));
test('nomsDesPlats renvoie les noms à plat, dans l\'ordre', (m, t) =>
  t.egal(t.sansMutation(CARTE(), (c) => m.nomsDesPlats(c)), ['Soupe', 'Salade', 'Burger', 'Risotto', 'Tiramisu']));
test('une rubrique vide vaut 0 plat, 0 euro et []', (m, t) => {
  const vide = { nom: 'Suggestions', enfants: [] };
  t.egal(m.compterPlats(vide), 0);
  t.egal(m.totalCarte(vide), 0);
  t.egal(m.nomsDesPlats(vide), []);
});
