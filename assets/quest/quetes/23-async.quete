  );

const preparerCommande = (noms) => {
  // TODO : tous les plats en parallèle
};

const totalCommande = async (noms) => {
  // TODO
};

const pipeAsync = (...fonctions) => {
  // TODO
};

module.exports = { preparerCommande, totalCommande, pipeAsync };

=== solution
// Quête 23 — Les fourneaux en parallèle

const CUISINE = { Burger: 14, Soupe: 7, Risotto: 13, Tiramisu: 6 };
const chercherPlat = (nom) =>
  new Promise((resolve, reject) =>
    setTimeout(() => (nom in CUISINE ? resolve({ nom, prix: CUISINE[nom] }) : reject(new Error(`Plat inconnu : ${nom}`))), 40)
  );

const preparerCommande = (noms) => Promise.all(noms.map(chercherPlat));

const totalCommande = async (noms) => {
  const plats = await preparerCommande(noms);
  return plats.reduce((somme, plat) => somme + plat.prix, 0);
};

const pipeAsync = (...fonctions) => (valeur) =>
  fonctions.reduce((promesse, fn) => promesse.then(fn), Promise.resolve(valeur));

module.exports = { preparerCommande, totalCommande, pipeAsync };

=== indices
`noms.map(chercherPlat)` donne un tableau de promesses. `Promise.all(...)` les réunit en une seule.
---
Dans `totalCommande`, écris `const plats = await preparerCommande(noms);` puis additionne les prix avec `reduce`.
---
`pipeAsync` ressemble à `pipe`, mais l'accumulateur est une promesse : `fonctions.reduce((promesse, fn) => promesse.then(fn), Promise.resolve(valeur))`.

=== tests
interdit(/\b(for|while)\b|\.forEach\(|\.push\(/, 'pas de boucle ni de push');
test('preparerCommande renvoie les plats dans l\'ordre demandé', async (m, t) =>
  t.egal(await m.preparerCommande(['Soupe', 'Burger']), [{ nom: 'Soupe', prix: 7 }, { nom: 'Burger', prix: 14 }]));
test('preparerCommande travaille en parallèle (4 plats en moins de 120 ms)', async (m, t) => {
  const debut = Date.now();
  await m.preparerCommande(['Soupe', 'Burger', 'Risotto', 'Tiramisu']);
  const duree = Date.now() - debut;
  t.vrai(duree < 120, `Durée mesurée : ${duree} ms. Les plats sont cherchés l'un après l'autre : utilise Promise.all avec map.`);
});
test('preparerCommande échoue si un plat est inconnu', async (m, t) => {
  let message = null;
  await Promise.resolve(m.preparerCommande(['Soupe', 'Pizza'])).catch((e) => {
    message = e.message;
  });
  t.egal(message, 'Plat inconnu : Pizza', 'La promesse doit échouer avec l\'erreur de la cuisine.');
});
test('totalCommande additionne les prix', async (m, t) => t.egal(await m.totalCommande(['Burger', 'Tiramisu']), 20));
test('totalCommande d\'une commande vide vaut 0', async (m, t) => t.egal(await m.totalCommande([]), 0));
test('pipeAsync enchaîne des étapes ordinaires et asynchrones', async (m, t) => {
  const f = m.pipeAsync((x) => x + 1, async (x) => x * 2, (x) => `${x} €`);
  t.vrai(typeof f === 'function', 'pipeAsync(...) doit renvoyer une fonction.');
  const promesse = f(3);
  t.vrai(promesse && typeof promesse.then === 'function', 'La fonction renvoyée par pipeAsync doit renvoyer une promesse.');
  t.egal(await promesse, '8 €');
});
test('pipeAsync() sans étape renvoie une promesse de la valeur', async (m, t) => t.egal(await m.pipeAsync()(5), 5));
