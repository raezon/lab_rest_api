=== solution
// Quête 14 — La chaîne de production

const retirerRemise = (prix) => prix - 2;
const ajouterTVA = (prix) => prix * 1.1;
const arrondir = (prix) => Math.round(prix * 100) / 100;

const pipe = (...fonctions) => (valeur) => fonctions.reduce((acc, fn) => fn(acc), valeur);

const compose = (...fonctions) => (valeur) => fonctions.reduceRight((acc, fn) => fn(acc), valeur);

const prixClient = pipe(retirerRemise, ajouterTVA, arrondir);

module.exports = { pipe, compose, prixClient };

=== indices
`pipe` renvoie une fonction `(valeur) => ...`. À l'intérieur, réduis le tableau `fonctions` en partant de `valeur`.
---
`fonctions.reduce((acc, fn) => fn(acc), valeur)` : à chaque tour, on applique la fonction courante à l'accumulateur.
---
`compose` est identique avec `reduceRight`. Et `const prixClient = pipe(retirerRemise, ajouterTVA, arrondir);`

=== tests
interdit(/\b(for|while)\b/, 'pas de boucle for ni while');
const plusUn = (x) => x + 1;
const double = (x) => x * 2;
test('pipe applique de gauche à droite : pipe(plusUn, double)(3) renvoie 8', (m, t) => t.egal(m.pipe(plusUn, double)(3), 8));
test('pipe accepte autant de fonctions que voulu', (m, t) => t.egal(m.pipe(plusUn, double, plusUn, String)(3), '9'));
test('pipe() sans fonction renvoie la valeur inchangée', (m, t) => t.egal(m.pipe()(5), 5));
test('compose applique de droite à gauche : compose(plusUn, double)(3) renvoie 7', (m, t) => t.egal(m.compose(plusUn, double)(3), 7));
test('prixClient(12) renvoie 11', (m, t) => {
  t.vrai(typeof m.prixClient === 'function', 'prixClient doit être une fonction : remplace undefined par un pipe.');
  t.egal(m.prixClient(12), 11);
});
test('prixClient(21.99) renvoie 21.99 (arrondi à deux décimales)', (m, t) => t.egal(m.prixClient(21.99), 21.99));
